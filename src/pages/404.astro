---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | ALp_Studio" description="访问的页面不存在或已被移除。" bodyClass="error-page">
  <main id="main-content" class="error-shell">
    <section class="blueprint-frame error-card" aria-labelledby="error-title">
      <div class="frame-label">
        <span class="frame-label__mark data-field">[!!]</span>
        <span class="frame-label__text">// SIGNAL.lost</span>
      </div>
      <p class="error-label data-field">错误码</p>
      <h1 class="error-code" id="error-title">404</h1>
      <p class="error-desc">信号丢失，目标坐标未在观测日志中注册，连接已被标记为缺失。</p>
      <a class="error-home data-field" href="/">回到首页</a>
    </section>
  </main>
</BaseLayout>
