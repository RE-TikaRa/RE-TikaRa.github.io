---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | ALp_Studio" description="访问的页面不存在或已被移除。" bodyClass="error-page">
  <main id="main-content" class="error-shell">
    <section class="card glass error-card" aria-labelledby="error-title">
      <p class="error-label">错误码</p>
      <h1 class="error-code" id="error-title">404</h1>
      <p class="error-desc">信号丢失，目标坐标未在观测日志中注册，连接已被标记为缺失。</p>
    </section>
    <div class="card glass error-cta">
      <a class="error-home" href="/">回到首页</a>
    </div>
  </main>
</BaseLayout>
