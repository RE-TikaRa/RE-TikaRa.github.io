---
import BaseLayout from '../layouts/BaseLayout.astro';
import Welcome from '../components/Welcome.astro';
import TitleBlock from '../components/TitleBlock.astro';
import ProfileCard from '../components/cards/ProfileCard.astro';
import DateCard from '../components/cards/DateCard.astro';
import ArticlesCard from '../components/cards/ArticlesCard.astro';
import WeatherCard from '../components/cards/WeatherCard.tsx';
import MusicCard from '../components/cards/MusicCard.tsx';
import HitokotoCard from '../components/cards/HitokotoCard.tsx';
import Cli from '../components/Cli.tsx';
---

<BaseLayout title="ALp_Studio">
  <Welcome />
  <TitleBlock active="home" />
  <div class="drafting-board">
    <div class="board-coords" aria-hidden="true">
      <div class="board-coords__row board-coords__row--top">
        <span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span>
      </div>
      <div class="board-coords__row board-coords__row--bottom">
        <span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span>
      </div>
      <div class="board-coords__col board-coords__col--left">
        <span>1</span><span>2</span><span>3</span>
      </div>
      <div class="board-coords__col board-coords__col--right">
        <span>1</span><span>2</span><span>3</span>
      </div>
    </div>

    <div class="board-plan" role="region" aria-label="控制台仪表盘">
      <main id="main-content" class="plan-cell plan-profile" aria-labelledby="profile-heading">
        <ProfileCard />
      </main>
      <div class="plan-cell plan-weather"><WeatherCard client:idle /></div>
      <div class="plan-cell plan-hitokoto"><HitokotoCard client:idle /></div>
      <div class="plan-cell plan-clock"><DateCard /></div>
      <div class="plan-cell plan-music"><MusicCard client:idle /></div>
    </div>

    <div class="plan-cell plan-articles"><ArticlesCard /></div>
  </div>

  <Cli client:idle />
</BaseLayout>

<script>
  import { fetchConfigJSON } from '../lib/config';
  import { normalizeExternalUrl } from '../lib/shared';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const greetingEl = document.getElementById('greeting');
  const todayEl = document.getElementById('today');
  const clockTimeEl = document.getElementById('clock-time');
  const clockWeekdayEl = document.getElementById('clock-weekday');
  const WEEKDAYS = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
  let lastGreetingKey = '';
  let lastDateKey = '';
  let lastTimeKey = '';
  let timer: number | null = null;

  function updateGreeting(now: Date) {
    const hours = now.getHours();
    const greetingKey = String(hours);
    if (greetingEl && greetingKey !== lastGreetingKey) {
      let text = '你好，实验体';
      if (hours >= 5 && hours <= 8) text = '早上好，开始今天的计划吧。';
      else if (hours >= 9 && hours <= 11) text = '上午好，来开始今天的计划吧。';
      else if (hours >= 12 && hours <= 13) text = '中午好，来享用午饭吧~';
      else if (hours >= 14 && hours <= 17) text = '下午好，来杯咖啡吧~';
      else if (hours >= 18 && hours <= 22) text = '晚上好，还在忙碌么？';
      else text = '夜深了，还不睡么？';
      if (!reduceMotion) {
        greetingEl.innerHTML = '';
        text.split('').forEach((char, i) => {
          const span = document.createElement('span');
          span.textContent = char;
          span.style.setProperty('--char-index', String(i));
          greetingEl.appendChild(span);
        });
      } else {
        greetingEl.textContent = text;
      }
      lastGreetingKey = greetingKey;
    }
    const y = now.getFullYear();
    const mo = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    const h = String(now.getHours()).padStart(2, '0');
    const mi = String(now.getMinutes()).padStart(2, '0');
    const s = String(now.getSeconds()).padStart(2, '0');

    if (clockTimeEl) {
      const timeKey = `${h}:${mi}:${s}`;
      if (timeKey !== lastTimeKey) {
        clockTimeEl.textContent = timeKey;
        lastTimeKey = timeKey;
      }
    }
    const dateKey = `${y}-${mo}-${d}`;
    if (dateKey !== lastDateKey) {
      if (todayEl) todayEl.textContent = `${y}.${mo}.${d}`;
      if (clockWeekdayEl) clockWeekdayEl.textContent = WEEKDAYS[now.getDay()];
      lastDateKey = dateKey;
    }
  }

  function schedule() {
    updateGreeting(new Date());
    const delay = 1000 - (Date.now() % 1000);
    timer = window.setTimeout(schedule, delay);
  }

  schedule();
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      if (timer) window.clearTimeout(timer);
      schedule();
    }
  });

  async function initLatestArticles() {
    const container = document.getElementById('latest-articles-card');
    const list = document.getElementById('article-list');
    if (!container || !list) return;

    const renderPlaceholder = (text: string) => {
      list.textContent = '';
      const item = document.createElement('li');
      item.className = 'article-item';
      const title = document.createElement('span');
      title.className = 'article-title';
      title.textContent = text;
      item.appendChild(title);
      list.appendChild(item);
    };

    try {
      const config = await fetchConfigJSON();
      const articles = Array.isArray(config?.latest_articles) ? config.latest_articles : [];
      if (articles.length === 0) {
        renderPlaceholder('暂无文章');
        return;
      }
      list.textContent = '';
      const fragment = document.createDocumentFragment();
      articles.forEach((article) => {
        const item = document.createElement('li');
        item.className = 'article-item';
        const link = document.createElement('a');
        link.className = 'article-link';
        link.href = normalizeExternalUrl(article?.link);
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        const title = document.createElement('span');
        title.className = 'article-title';
        title.textContent = typeof article?.title === 'string' ? article.title : '未命名文章';
        link.appendChild(title);
        if (article?.date) {
          const date = document.createElement('span');
          date.className = 'article-date';
          date.textContent = String(article.date);
          link.appendChild(date);
        }
        const action = document.createElement('span');
        action.className = 'article-action';
        action.textContent = '点击查看';
        link.appendChild(action);
        item.appendChild(link);
        fragment.appendChild(item);
      });
      list.appendChild(fragment);
    } catch (error) {
      console.error('Failed to load articles:', error);
      renderPlaceholder('文章加载失败');
    }
  }

  initLatestArticles();
</script>
