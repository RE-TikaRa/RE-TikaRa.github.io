---

<div id="welcome-screen" class="welcome-screen" aria-hidden="true">
  <div class="welcome-inner">
    <div class="welcome-mark-stack">
      <svg
        class="welcome-mark"
        viewBox="0 0 240 120"
        fill="none"
        role="img"
        aria-label="ALp_Studio"
      >
        <rect class="welcome-mark__frame" x="6" y="6" width="228" height="108" />
        <line class="welcome-mark__axis" x1="6" y1="60" x2="234" y2="60" />
        <line class="welcome-mark__axis" x1="120" y1="6" x2="120" y2="114" />
        <circle class="welcome-mark__node" cx="120" cy="60" r="4" />
      </svg>
      <div class="welcome-emblem" id="welcome-emblem"></div>
    </div>
    <p class="welcome-brand is-latin" lang="en">ALp_Studio</p>
    <p class="welcome-line data-field" id="welcome-line">// booting observation deck</p>
    <div class="welcome-bar"><span class="welcome-bar__fill" id="welcome-bar-fill"></span></div>
  </div>
</div>
