---
---

<section class="blueprint-frame profile-card">
  <div class="frame-label">
    <span class="frame-label__mark data-field">[00]</span>
    <span class="frame-label__text">// PROFILE.unit</span>
  </div>
  <div class="profile-body">
    <div class="avatar-large">
      <img src="https://s2.loli.net/2025/12/22/mkWtIYraVxdnTCe.jpg" alt="亓翎_Re-TikaRa 的头像" />
    </div>
    <div class="profile-text">
      <h2 class="profile-name" id="profile-heading">亓翎_Re-TikaRa</h2>
      <p class="profile-greeting greeting-title" id="greeting" aria-label="问候语">你好</p>
      <p class="profile-desc">一个人造生命体的自娱自乐</p>
    </div>
    <dl class="profile-stats">
      <div class="profile-stat">
        <dt class="profile-stat__key data-field">UNIT</dt>
        <dd class="profile-stat__val data-field">ALp-01</dd>
      </div>
      <div class="profile-stat">
        <dt class="profile-stat__key data-field">STATUS</dt>
        <dd class="profile-stat__val profile-stat__val--live data-field">ONLINE</dd>
      </div>
      <div class="profile-stat">
        <dt class="profile-stat__key data-field">BASE</dt>
        <dd class="profile-stat__val data-field">35.9N 104.1E</dd>
      </div>
    </dl>
    <div class="profile-clock">
      <p class="clock-time data-field" id="clock-time">--:--:--</p>
      <p class="clock-date data-field" id="today">——</p>
      <div class="clock-meta">
        <span class="clock-weekday data-field" id="clock-weekday">——</span>
        <span class="clock-tz data-field">UTC+08</span>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .profile-body {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 2.4rem;
  }
  .avatar-large {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    border: var(--frame-border-width) solid var(--color-border);
    padding: 4px;
    background: var(--color-surface-sunk);
  }
  .profile-text {
    flex: 1;
    min-width: 0;
  }
  .profile-stats {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.5rem;
    border-left: 1px dashed var(--color-grid-major);
  }
  .profile-stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem;
  }
  .profile-stat__key {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-dim);
  }
  .profile-stat__val {
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }
  .profile-stat__val--live {
    color: var(--color-accent);
  }
  .profile-stat__val--live::before {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent);
    vertical-align: middle;
  }
  .profile-clock {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding-left: 1.5rem;
    border-left: 1px dashed var(--color-grid-major);
  }
  .clock-time {
    font-family: var(--font-data);
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin: 0;
  }
  .clock-date {
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    margin: 0;
  }
  .clock-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem;
    margin-top: 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--color-grid-major);
  }
  .clock-weekday {
    font-size: 1.02rem;
    color: var(--color-ink);
  }
  .clock-tz {
    font-family: var(--font-data);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-dim);
  }
  @media (max-width: 780px) {
    .profile-clock {
      display: none;
    }
  }
  .avatar-large img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.05);
  }
  .profile-name {
    font-family: var(--font-display);
    font-size: 2.8rem;
    letter-spacing: 0.01em;
    margin-bottom: 0.5rem;
  }
  .profile-greeting {
    font-family: var(--font-data);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin: 0 0 0.8rem;
    min-height: 1.4em;
  }
  .profile-greeting :global(span) {
    display: inline-block;
  }
  .profile-desc {
    font-size: 1.05rem;
    color: var(--color-ink-dim);
    padding-left: 0.7rem;
    border-left: 2px solid var(--color-grid-major);
    margin: 0;
  }

  @media (max-width: 480px) {
    .profile-body {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
