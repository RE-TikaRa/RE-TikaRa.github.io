---
interface Props {
  active?: 'home' | 'projects';
}
const { active = 'home' } = Astro.props;
---

<nav class="mobile-nav" aria-label="移动端导航">
  <a href="/" class={`mobile-nav-item${active === 'home' ? ' is-active' : ''}`} id="mobile-nav-home">
    <i class="fa-solid fa-house" aria-hidden="true"></i>
    <span>主页</span>
  </a>
  <a href="/projects/" class={`mobile-nav-item${active === 'projects' ? ' is-active' : ''}`}>
    <i class="fa-solid fa-code" aria-hidden="true"></i>
    <span>项目</span>
  </a>
  <a href="https://www.re-tikara.fun/Blog" target="_blank" rel="noopener noreferrer" class="mobile-nav-item">
    <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
    <span>博客</span>
  </a>
  <a href="https://re-tikara.fun/Article/" target="_blank" rel="noopener noreferrer" class="mobile-nav-item">
    <i class="fa-solid fa-book-open" aria-hidden="true"></i>
    <span>文章</span>
  </a>
  <a href="https://github.com/RE-TikaRa" target="_blank" rel="noopener noreferrer" class="mobile-nav-item">
    <i class="fa-brands fa-github" aria-hidden="true"></i>
    <span>GitHub</span>
  </a>
</nav>
